{
  "manifest_version": 3,
  "name": "장면 캡처 도구",
  "short_name": "장면캡처",
  "version": "1.11.4",
  "description": "유튜브 경기 영상 분석용 — 라운드 자동 찾기 · S키 장면 캡처·메모 · 분석 화면(미니맵·장면·스크린샷 위에 그리기) · PPT·텍틱 시트로 보내기",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "장면 캡처 도구 — 관리 페이지",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "manage.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "kill-old.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "yt-quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "terms.js",
        "names.js",
        "content.js",
        "hud-tpl.js",
        "rounds.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "analyze.html",
        "manage.html"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
